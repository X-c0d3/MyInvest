# Copy to .env on the VPS and fill in. Read by docker-compose.yml.

# Host port the app is published on: http://<vps>:3004
APP_PORT=3004

# false = sign-up only until the first account exists (recommended on a public server).
ALLOW_REGISTRATION=false

# true = the login cookie is sent over HTTPS only. Keep true when an HTTPS proxy sits in front.
# Set false only if you open http://<vps>:3004 directly, or login will not stick.
COOKIE_SECURE=true

# Only for `docker compose --profile caddy up`: a domain whose DNS A record points at the VPS;
# Caddy issues HTTPS for it on ports 80/443.
DOMAIN=
